# Environment Variables for Learn-Algo

# Show TheoryModal by default on playground pages
# Set to 'true' to automatically open theory modals when visiting algorithm playgrounds
# Set to 'false' or leave unset to require manual opening of theory modals
NEXT_PUBLIC_SHOW_THEORY_MODAL_BY_DEFAULT=false

# Environment Variables for Movie PCA Dataset

# S3 URLs for pre-computed embeddings and posters
# Replace with your actual S3 bucket URLs after running the Python script

# Movies embeddings CSV file
NEXT_PUBLIC_MOVIES_EMBEDDINGS_URL=https://your-bucket.s3.us-east-1.amazonaws.com/movies-with-embeddings.csv

# Sprite manifest JSON file for movie posters
NEXT_PUBLIC_SPRITE_MANIFEST_URL=https://your-bucket.s3.us-east-1.amazonaws.com/sprites/manifest.json

# Optional: Use CloudFront for better performance
# NEXT_PUBLIC_MOVIES_EMBEDDINGS_URL=https://d12345.cloudfront.net/movies-with-embeddings.csv
# NEXT_PUBLIC_SPRITE_MANIFEST_URL=https://d12345.cloudfront.net/sprites/manifest.json
